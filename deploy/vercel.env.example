# Vercel Production only. Preview must use a separate database/bucket and URL.
# No value in this file uses VITE_: these are server-only settings.
CLARORA_MODE=public
# Set to 1 only after Resend/domain verification and real email delivery testing.
EMAIL_LOGIN_ENABLED=0
CLARORA_PUBLIC_URL=https://YOUR-APP.vercel.app
# Supabase Connect > Transaction pooler; copy actual region/host, URL-encode password.
DATABASE_URL=postgresql://postgres.bemxbmbtvttirklkpmjx:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
CLARORA_STORAGE_BACKEND=s3
S3_ENDPOINT_URL=https://bemxbmbtvttirklkpmjx.storage.supabase.co/storage/v1/s3
S3_BUCKET=clarora-private
# Copy the project's actual region and S3 credentials from Storage settings.
AWS_REGION=PROJECT_REGION
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CRON_SECRET=
NEWS_BACKGROUND_ENABLED=0
PUBLIC_FORECAST_BACKGROUND_ENABLED=0
# Start disabled. Enable after AI credentials and protected cron are verified.
DAILY_BRIEF_ENABLED=0
DAILY_BRIEF_HOUR=8
SEC_USER_AGENT=Clarora/0.3 YOUR_CONTACT_EMAIL
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
TWELVE_DATA_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
CLARORA_ADMIN_EMAILS=
CLARORA_ADMIN_USER_IDS=
BILLING_ADMIN_USER_IDS=
# Internal beta: no live payments. Enable only when sandbox credentials exist.
BILLING_TEST_ENABLED=0
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_TEST_PORTAL_CONFIGURATION=
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_SANDBOX_WEBHOOK_ID=
