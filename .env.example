# SEC requests require an identifiable application and contact address.
SEC_USER_AGENT=MeridianResearch/0.2 your-email@example.com
# Backend only. Save .env then click Check configuration; no VITE_ prefix.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Twelve Data: server-only market data key
TWELVE_DATA_API_KEY=

# Optional paid consensus feed. Free official macro data needs no additional key.
# Backend only. Trading Economics calendar access (client:secret).
TRADING_ECONOMICS_API_KEY=

# Optional official X recent-search access. RSS news and Reddit do not require this.
X_BEARER_TOKEN=

# Daily AI edition; Australia/Sydney, once per day while backend runs.
DAILY_BRIEF_ENABLED=1
DAILY_BRIEF_HOUR=8

# Membership: local keeps the existing single-user development workflow.
# NEVER expose local mode through a public proxy. Production must use public.
CLARORA_MODE=local
CLARORA_PUBLIC_URL=http://127.0.0.1:5173
# Optional absolute path; default server/cache/membership.sqlite3 (private).
CLARORA_DATABASE=
# Public login uses one-time email links; local mode only shows a local link.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# Payment implementation is TEST ONLY. Keep disabled until test accounts exist.
# Australia merchant: Stripe card/Apple Pay (AUD/USD), Alipay one-off (CNY).
# PayPal needs a separate merchant integration; not Stripe's European PayPal flow.
BILLING_TEST_ENABLED=0
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_TEST_PORTAL_CONFIGURATION=
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_SANDBOX_WEBHOOK_ID=
# Comma-separated account UUIDs from /api/account. Never emails or client flags.
BILLING_ADMIN_USER_IDS=

# Account administrators; verified login required. Does not grant paid membership.
CLARORA_ADMIN_EMAILS=
CLARORA_ADMIN_USER_IDS=

# Cloud deployment (Supabase PostgreSQL or AWS RDS); empty keeps local SQLite only.
DATABASE_URL=
# Local files by default; cloud uses private S3-compatible storage.
CLARORA_STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CRON_SECRET=
# Full production template: deploy/vercel.env.example

# Google web OAuth; callback: CLARORA_PUBLIC_URL/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
