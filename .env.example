# SEC requests require an identifiable application and contact address.
SEC_USER_AGENT=MeridianResearch/0.2 your-email@example.com
# Backend only. Save .env then click Check configuration; no VITE_ prefix.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Twelve Data: server-only market data key
TWELVE_DATA_API_KEY=

# Optional paid consensus feed. Free official macro data needs no additional key.
# Backend only. Trading Economics calendar access (client:secret).
TRADING_ECONOMICS_API_KEY=

# Optional official X recent-search access. RSS news and Reddit do not require this.
X_BEARER_TOKEN=

# Daily AI edition; Australia/Sydney, once per day while backend runs.
DAILY_BRIEF_ENABLED=1
DAILY_BRIEF_HOUR=8
